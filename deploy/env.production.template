# Agrisynthia production environment.
#
# Copy to /opt/agrisynthia/.env on the production host and fill in every
# <PLACEHOLDER>. Do not commit the filled-in file.
#
#   install -o agrisynthia -g agrisynthia -m 600 env.production.template /opt/agrisynthia/.env
#
# settings.py calls load_dotenv() on this file directly, so the systemd units
# deliberately do NOT use EnvironmentFile=. That avoids systemd's stricter
# quoting rules mangling values with spaces, such as DEFAULT_FROM_EMAIL.

# ==============================================================================
# CORE
# ==============================================================================

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<GENERATE_A_FRESH_50_CHAR_KEY>
DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=agrisynthia.com,www.agrisynthia.com

# Full URLs with scheme. Required by Django 4+ for HTTPS POSTs.
CSRF_TRUSTED_ORIGINS=https://agrisynthia.com,https://www.agrisynthia.com

# Browser origins allowed to call the API. Leave blank if the API is same-origin only.
CORS_ALLOWED_ORIGINS=https://agrisynthia.com

# ==============================================================================
# DATABASE
# ==============================================================================
# There is no DATABASE_URL. settings.py reads these five discretely and falls
# back to SQLite if any of NAME/USER/PASSWORD/HOST is missing, so an incomplete
# block here fails silently into the wrong database. Verify after first deploy:
#   python manage.py shell -c "from django.db import connection; print(connection.settings_dict['ENGINE'])"

DATABASE_NAME=agrisynthia
DATABASE_USER=agrisynthia_user
DATABASE_PASSWORD=<STRONG_DB_PASSWORD>
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Requires GDAL/GEOS on the host and the PostGIS extension on the database:
#   CREATE EXTENSION IF NOT EXISTS postgis;
GEODJANGO_ENABLED=True

# Leave blank on Linux. System GDAL is auto-detected.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# ==============================================================================
# REDIS
# ==============================================================================
# There is no REDIS_URL. Broker and cache use separate logical databases.
# If Redis has a password: redis://:PASSWORD@127.0.0.1:6379/0

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
REDIS_PASSWORD=<REDIS_PASSWORD_OR_BLANK>

# ==============================================================================
# EMAIL (Resend)
# ==============================================================================
# The domain must be verified in Resend (DKIM + SPF + return-path DNS records)
# before any mail is delivered. Without these, verification, password reset,
# and 2FA mail fails and settings.py only emits a RuntimeWarning.

DEFAULT_FROM_EMAIL=Agrisynthia <noreply@agrisynthia.com>
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=<RESEND_API_KEY>
EMAIL_TIMEOUT=10

# ==============================================================================
# CLOUDFLARE R2
# ==============================================================================
# R2 object storage. Credentials come from the Cloudflare dashboard.

USE_R2=True
R2_ACCOUNT_ID=<R2_ACCOUNT_ID>
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=agrisynthia
# Public hostname for the bucket. Leave blank to use the R2 endpoint directly.
R2_CUSTOM_DOMAIN=

# ==============================================================================
# CHATBOT
# ==============================================================================
# Powers /chat/ on the marketing site. Leave blank to disable the endpoint.

ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY_OR_BLANK>

# ==============================================================================
# MONITORING
# ==============================================================================

SENTRY_DSN=<SENTRY_DSN_OR_BLANK>
GRAFANA_ADMIN_PASSWORD=<GRAFANA_PASSWORD>

# Webhook and recipients for model degradation alerts.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=ops@agrisynthia.com
ALERT_COOLDOWN_SECONDS=3600

# ==============================================================================
# ODM / SATELLITE / RETENTION
# ==============================================================================
# Set ODM_ENABLED=False if no NodeODM instance is reachable; drone projects
# then expect pre-processed orthophotos.

ODM_ENABLED=True
ODM_HOST=127.0.0.1
ODM_PORT=3000
ODM_TOKEN=
ODM_STUCK_TIMEOUT_MINUTES=120

SENTINEL2_CLOUD_MAX=30
NDVI_STRESS_THRESHOLD=0.3
NDVI_WARN_THRESHOLD=0.5
NDVI_ALERT_COOLDOWN_DAYS=7

# Detection results and their media older than this are deleted daily.
RESULT_RETENTION_DAYS=30

# Refuse to load YOLO weights whose SHA-256 does not match ModelVersion.
# Backfill checksums first: python manage.py verify_model_checksums --store
MODEL_CHECKSUM_VERIFY=True
